# BotFather'dan olgan tokeningiz
BOT_TOKEN=123456789:AAExampleTokenHereReplaceMe

# Sizning Telegram ID raqamingiz (admin). @userinfobot orqali bilib oling.
ADMIN_ID=123456789

# PostgreSQL ulanishi. Agar DATABASE_URL to'ldirilsa, pastdagi DB_* lar e'tiborga olinmaydi.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quiz_bot

# DATABASE_URL bo'sh qoldirilsa, shu o'zgaruvchilar ishlatiladi
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quiz_bot
DB_USER=postgres
DB_PASSWORD=postgres
